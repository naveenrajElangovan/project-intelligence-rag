PI_RAG_ENVIRONMENT=development
PI_RAG_ALLOWED_HOSTS=localhost,127.0.0.1,rag,testserver
PI_RAG_FORCE_HTTPS=false
PI_RAG_DOCS_ENABLED=true
PI_RAG_MAX_REQUEST_BODY_BYTES=262144
PI_RAG_RATE_LIMIT_PER_MINUTE=120
PI_RAG_INTERNAL_API_KEY=replace-with-at-least-32-random-characters
PI_RAG_SUPPORTED_EMBEDDING_MODELS=["multilingual-e5-large"]
PI_RAG_SUPPORTED_SCHEMA_VERSIONS=["3"]
PI_RAG_MAX_ENTITY_EXPANSIONS=5
PI_RAG_POPULATION_CONTRACT_MAX_MEMBERS=100
PI_RAG_INCREMENTAL_VERIFIED_STREAMING_ENABLED=true
PI_RAG_PINECONE_API_KEY=
PI_RAG_ALLOWED_INDEX_HOSTS=
PI_RAG_LLM_PROVIDER=ollama
PI_RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
PI_RAG_OLLAMA_MODEL=qwen3.5:latest
# Same as the generator by default so only one model stays resident. Setting a
# different planner model is only a win if `ollama ps` shows both loaded at once;
# otherwise every request pays a model swap.
PI_RAG_OLLAMA_PLANNER_MODEL=qwen3.5:latest
# Left unset here on purpose: scripts/start_local_macos.sh sizes this from
# sysctl hw.memsize. Set it explicitly to override the detected tier.
# PI_RAG_OLLAMA_CONTEXT_TOKENS=32768
PI_RAG_OLLAMA_MAX_OUTPUT_TOKENS=768
PI_RAG_OLLAMA_KEEP_ALIVE=5m
PI_RAG_OLLAMA_REASONING_ENABLED=false
# Pinned neutral so a Modelfile default cannot penalise the verbatim repetition
# that citation and grounding depend on. pi-qwen3.5:2026-08 ships presence_penalty 1.5.
PI_RAG_OLLAMA_PRESENCE_PENALTY=0.0
PI_RAG_OLLAMA_REPEAT_PENALTY=1.0
# Whole-prompt budgeting: evidence gets what the fixed parts leave.
PI_RAG_PROMPT_OVERHEAD_RESERVE_TOKENS=2048
PI_RAG_MAX_CONVERSATION_HISTORY_TOKENS=2000
PI_RAG_MAX_SEMANTIC_CONTEXT_TOKENS=1000
PI_RAG_LOCAL_INFERENCE_ENABLED=true
PI_RAG_WARM_LOCAL_MODELS_ON_STARTUP=true
PI_RAG_LOCAL_MAX_CONCURRENCY=1
PI_RAG_OPENAI_API_KEY=
PI_RAG_OPENAI_BUDGET_MODEL=gpt-5-nano
PI_RAG_OPENAI_STANDARD_MODEL=gpt-5-mini
PI_RAG_OPENAI_COMPLEX_MODEL=gpt-5
PI_RAG_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
PI_RAG_AZURE_OPENAI_API_KEY=
PI_RAG_AZURE_OPENAI_DEPLOYMENT=
PI_RAG_AZURE_OPENAI_USE_MANAGED_IDENTITY=false
PI_RAG_RETRIEVAL_TOP_K=25
PI_RAG_RETRIEVAL_SCORE_THRESHOLD=0.0
PI_RAG_ADAPTIVE_QUERY_ENABLED=true
PI_RAG_QUERY_EXPANSION_ENABLED=true
PI_RAG_HYDE_ENABLED=false
PI_RAG_MAX_QUERY_VARIANTS=3
PI_RAG_MAX_RETRIEVAL_ATTEMPTS=2
PI_RAG_DEPENDENCY_RETRY_ATTEMPTS=3
PI_RAG_DEPENDENCY_TIMEOUT_SECONDS=20
PI_RAG_LEXICAL_FALLBACK_ENABLED=true
PI_RAG_LEXICAL_FALLBACK_MAX_RECORDS=5000
PI_RAG_LEXICAL_FALLBACK_CACHE_TTL_SECONDS=300
PI_RAG_WARM_LEXICAL_CORPUS_ON_STARTUP=true
PI_RAG_VOCABULARY_CACHE_TTL_SECONDS=300
PI_RAG_LLM_RETRY_ATTEMPTS=2
PI_RAG_LLM_TIMEOUT_SECONDS=45
PI_RAG_LLM_STREAM_IDLE_TIMEOUT_SECONDS=20
PI_RAG_LLM_STREAM_TOTAL_TIMEOUT_SECONDS=180
PI_RAG_REQUEST_TIMEOUT_SECONDS=240
PI_RAG_RANK_FUSION_K=60
PI_RAG_LEXICAL_FUSION_WEIGHT=1.25
PI_RAG_DENSE_FUSION_WEIGHT=1.0
PI_RAG_EXACT_TERM_BOOST=0.15
PI_RAG_SOURCE_VOLUME_DISCOUNT_STRENGTH=0.0
PI_RAG_NEIGHBOR_EXPANSION_ENABLED=true
PI_RAG_MAX_NEIGHBORS_PER_ANCHOR=1
# Local embedding removes the monthly Pinecone integrated-embedding token quota
# from the request path. Requires scripts/download_local_embedder.py once.
PI_RAG_EMBEDDING_PROVIDER=local
PI_RAG_EMBEDDING_DIMENSIONS=1024
PI_RAG_LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-large
PI_RAG_LOCAL_EMBEDDING_REVISION=
PI_RAG_LOCAL_EMBEDDING_DEVICE=mps
PI_RAG_LOCAL_EMBEDDING_PATH=.models/multilingual-e5-large
PI_RAG_LOCAL_EMBEDDING_BATCH_SIZE=16
PI_RAG_WARM_LOCAL_EMBEDDER_ON_STARTUP=true
PI_RAG_RERANK_PROVIDER=local
PI_RAG_RERANK_MODEL=bge-reranker-v2-m3
PI_RAG_LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
PI_RAG_GROUNDING_SCORE_THRESHOLD=0.65
PI_RAG_GROUNDING_CROSS_LANGUAGE_SCORE_THRESHOLD=0.60
# Rewrite Markdown tables as one sentence per row before the cross-encoder sees
# them, on the scoring path only. The generator still receives the original
# table. Leave on unless a corpus has tables the linearizer mis-reads.
PI_RAG_LINEARIZE_TABLE_EVIDENCE=true
# Optional, and off by default: a lower grounding bar for claims whose evidence
# is a table. Linearization is meant to make the normal bar reachable; set this
# only after evaluation/inspect_grounding_evidence.py shows the linearized score
# still falling short on evidence that does support the claim.
PI_RAG_GROUNDING_TABLE_EVIDENCE_SCORE_THRESHOLD=0.60
PI_RAG_EXACT_CODE_RERANK_SCORE_THRESHOLD=0.65
PI_RAG_EXACT_CODE_RETRIEVAL_SCORE_FLOOR=0.80
PI_RAG_LOCAL_RERANK_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
PI_RAG_LOCAL_RERANK_DEVICE=mps
# A 50-candidate pool at batch 8 is seven sequential MPS round trips.
PI_RAG_LOCAL_RERANK_BATCH_SIZE=32
PI_RAG_LOCAL_MODELS_PATH=
PI_RAG_RERANK_TOP_N=8
PI_RAG_FEATURE_INVENTORY_TOP_N=25
PI_RAG_RERANK_SCORE_THRESHOLD=0.10
PI_RAG_ENTITY_OVERVIEW_RERANK_SCORE_THRESHOLD=0.05
PI_RAG_MAX_CANDIDATES=50
PI_RAG_MAX_CHUNKS_PER_SOURCE=3
PI_RAG_MAX_EVIDENCE_TOKENS=16000
PI_RAG_ADAPTIVE_TEMPERATURE_ENABLED=true
PI_RAG_FACTUAL_TEMPERATURE=0.0
PI_RAG_SYNTHESIS_TEMPERATURE=0.1
PI_RAG_TRANSLATION_ENABLED=true
PI_RAG_GROUNDING_VERIFICATION_ENABLED=true
