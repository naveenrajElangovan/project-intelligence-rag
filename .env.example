# Configures pi rag environment.
PI_RAG_ENVIRONMENT=development
# Configures pi rag allowed hosts.
PI_RAG_ALLOWED_HOSTS=localhost,127.0.0.1,rag,testserver
# Configures pi rag force https.
PI_RAG_FORCE_HTTPS=false
# Enables or disables pi rag docs enabled.
PI_RAG_DOCS_ENABLED=true
# Configures pi rag max request body bytes.
PI_RAG_MAX_REQUEST_BODY_BYTES=262144
# Configures pi rag rate limit per minute.
PI_RAG_RATE_LIMIT_PER_MINUTE=120
# Secret value for pi rag internal api key; inject it per environment and never commit a real value.
PI_RAG_INTERNAL_API_KEY=replace-with-at-least-32-random-characters
# Answers are English or Spanish only; this is the tie-break for a question
# that carries no recognisable signal in either language.
PI_RAG_DEFAULT_RESPONSE_LANGUAGE=es
# Enables or disables pi rag openinference enabled.
PI_RAG_OPENINFERENCE_ENABLED=true
# Network location for pi rag openinference otlp endpoint.
PI_RAG_OPENINFERENCE_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# metadata_only is the safe default. full_authorized records only the authorized
# question, final answer, and evidence selected for the model; credentials and
# raw identity/policy values remain excluded.
PI_RAG_OPENINFERENCE_CONTENT_MODE=metadata_only
# Configures pi rag openinference project name.
PI_RAG_OPENINFERENCE_PROJECT_NAME=project-intelligence-rag
# Configures pi rag openinference success sample rate.
PI_RAG_OPENINFERENCE_SUCCESS_SAMPLE_RATE=0.10
# Configures pi rag prompt version.
PI_RAG_PROMPT_VERSION=development
# Offline quality monitoring only; these values are not runtime answer gates.
PI_RAG_PHOENIX_URL=http://127.0.0.1:6006
# Secret value for pi rag phoenix api key; inject it per environment and never commit a real value.
PI_RAG_PHOENIX_API_KEY=
# Configures pi rag quality project id.
PI_RAG_QUALITY_PROJECT_ID=T2.0
# Configures pi rag ragas references.
PI_RAG_RAGAS_REFERENCES=/absolute/path/to/reviewed-bilingual-references.jsonl
# Configures pi rag ragas model.
PI_RAG_RAGAS_MODEL=pi-qwen3.5:2026-08
# Configures pi rag dataset version.
PI_RAG_DATASET_VERSION=1
# Configures pi rag supported embedding models.
PI_RAG_SUPPORTED_EMBEDDING_MODELS=["multilingual-e5-large"]
# Configures pi rag supported schema versions.
PI_RAG_SUPPORTED_SCHEMA_VERSIONS=["3"]
# Configures pi rag max entity expansions.
PI_RAG_MAX_ENTITY_EXPANSIONS=5
# Configures pi rag population contract max members.
PI_RAG_POPULATION_CONTRACT_MAX_MEMBERS=100
# Enables or disables pi rag incremental verified streaming enabled.
PI_RAG_INCREMENTAL_VERIFIED_STREAMING_ENABLED=true
# Secret value for pi rag pinecone api key; inject it per environment and never commit a real value.
PI_RAG_PINECONE_API_KEY=
# Configures pi rag allowed index hosts.
PI_RAG_ALLOWED_INDEX_HOSTS=
# Configures pi rag llm provider.
PI_RAG_LLM_PROVIDER=ollama
# Network location for pi rag ollama base url.
PI_RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Configures pi rag ollama model.
PI_RAG_OLLAMA_MODEL=qwen3.5:latest
# Same as the generator by default so only one model stays resident. Setting a
# different planner model is only a win if `ollama ps` shows both loaded at once;
# otherwise every request pays a model swap.
PI_RAG_OLLAMA_PLANNER_MODEL=qwen3.5:latest
# Left unset here on purpose: scripts/start_local_macos.sh sizes this from
# sysctl hw.memsize. Set it explicitly to override the detected tier.
# PI_RAG_OLLAMA_CONTEXT_TOKENS=32768
PI_RAG_OLLAMA_MAX_OUTPUT_TOKENS=768
# Configures pi rag ollama keep alive.
PI_RAG_OLLAMA_KEEP_ALIVE=5m
# Enables or disables pi rag ollama reasoning enabled.
PI_RAG_OLLAMA_REASONING_ENABLED=false
# Pinned neutral so a Modelfile default cannot penalise the verbatim repetition
# that citation and grounding depend on. pi-qwen3.5:2026-08 ships presence_penalty 1.5.
PI_RAG_OLLAMA_PRESENCE_PENALTY=0.0
# Configures pi rag ollama repeat penalty.
PI_RAG_OLLAMA_REPEAT_PENALTY=1.0
# Whole-prompt budgeting: evidence gets what the fixed parts leave.
PI_RAG_PROMPT_OVERHEAD_RESERVE_TOKENS=2048
# Secret value for pi rag max conversation history tokens; inject it per environment and never commit a real value.
PI_RAG_MAX_CONVERSATION_HISTORY_TOKENS=2000
# Secret value for pi rag max semantic context tokens; inject it per environment and never commit a real value.
PI_RAG_MAX_SEMANTIC_CONTEXT_TOKENS=1000
# Enables or disables pi rag local inference enabled.
PI_RAG_LOCAL_INFERENCE_ENABLED=true
# Configures pi rag warm local models on startup.
PI_RAG_WARM_LOCAL_MODELS_ON_STARTUP=true
# Configures pi rag local max concurrency.
PI_RAG_LOCAL_MAX_CONCURRENCY=1
# Keep this false when the host accelerator is used with an index whose stored
# embeddings were produced on CPU; reranking and grounding still use MPS.
PI_RAG_LOCAL_ACCELERATOR_EMBEDDING_ENABLED=false
# Connection-level replays only; a timed-out accelerator call is never resent.
PI_RAG_LOCAL_ACCELERATOR_RETRY_ATTEMPTS=2
# Secret value for pi rag openai api key; inject it per environment and never commit a real value.
PI_RAG_OPENAI_API_KEY=
# Configures pi rag openai budget model.
PI_RAG_OPENAI_BUDGET_MODEL=gpt-5-nano
# Configures pi rag openai standard model.
PI_RAG_OPENAI_STANDARD_MODEL=gpt-5-mini
# Configures pi rag openai complex model.
PI_RAG_OPENAI_COMPLEX_MODEL=gpt-5
# Network location for pi rag azure openai endpoint.
PI_RAG_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# Secret value for pi rag azure openai api key; inject it per environment and never commit a real value.
PI_RAG_AZURE_OPENAI_API_KEY=
# Configures pi rag azure openai deployment.
PI_RAG_AZURE_OPENAI_DEPLOYMENT=
# Configures pi rag azure openai use managed identity.
PI_RAG_AZURE_OPENAI_USE_MANAGED_IDENTITY=false
# Configures pi rag retrieval top k.
PI_RAG_RETRIEVAL_TOP_K=25
# Configures pi rag retrieval score threshold.
PI_RAG_RETRIEVAL_SCORE_THRESHOLD=0.0
# Enables or disables pi rag adaptive query enabled.
PI_RAG_ADAPTIVE_QUERY_ENABLED=true
# Enables or disables pi rag query expansion enabled.
PI_RAG_QUERY_EXPANSION_ENABLED=true
# Enables or disables pi rag hyde enabled.
PI_RAG_HYDE_ENABLED=false
# Configures pi rag max query variants.
PI_RAG_MAX_QUERY_VARIANTS=3
# Configures pi rag max retrieval attempts.
PI_RAG_MAX_RETRIEVAL_ATTEMPTS=2
# Configures pi rag dependency retry attempts.
PI_RAG_DEPENDENCY_RETRY_ATTEMPTS=3
# Configures pi rag dependency timeout seconds.
PI_RAG_DEPENDENCY_TIMEOUT_SECONDS=20
# Query embedding sits outside the Chroma retry loop, so it carries its own
# bound. Applied as the accelerator socket timeout, never as a cancelled await.
PI_RAG_QUERY_EMBEDDING_TIMEOUT_SECONDS=30
# Enables or disables pi rag lexical fallback enabled.
PI_RAG_LEXICAL_FALLBACK_ENABLED=true
# Configures pi rag lexical fallback max records.
PI_RAG_LEXICAL_FALLBACK_MAX_RECORDS=5000
# Configures pi rag lexical fallback cache ttl seconds.
PI_RAG_LEXICAL_FALLBACK_CACHE_TTL_SECONDS=300
# Configures pi rag warm lexical corpus on startup.
PI_RAG_WARM_LEXICAL_CORPUS_ON_STARTUP=true
# Configures pi rag vocabulary cache ttl seconds.
PI_RAG_VOCABULARY_CACHE_TTL_SECONDS=300
# Configures pi rag llm retry attempts.
PI_RAG_LLM_RETRY_ATTEMPTS=2
# Configures pi rag llm timeout seconds.
PI_RAG_LLM_TIMEOUT_SECONDS=45
# Configures pi rag llm stream idle timeout seconds.
PI_RAG_LLM_STREAM_IDLE_TIMEOUT_SECONDS=20
# Prefill emits nothing, so the first chunk needs its own allowance. Size this
# above the observed p99 of time_to_first_chunk_seconds on the generate stage.
# Measured p99/max: 1.874 s for ten six-document, ~3k-token runs on 2026-09-04.
PI_RAG_LLM_STREAM_FIRST_CHUNK_TIMEOUT_SECONDS=30
# Configures pi rag llm stream total timeout seconds.
PI_RAG_LLM_STREAM_TOTAL_TIMEOUT_SECONDS=180
# One generation call plus at most this many shaping repairs, each retried, must
# fit inside PI_RAG_REQUEST_TIMEOUT_SECONDS. The validator enforces it.
PI_RAG_MAX_ANSWER_REPAIRS=1
# Configures pi rag request timeout seconds.
PI_RAG_REQUEST_TIMEOUT_SECONDS=240
# Configures pi rag rank fusion k.
PI_RAG_RANK_FUSION_K=60
# Configures pi rag lexical fusion weight.
PI_RAG_LEXICAL_FUSION_WEIGHT=1.25
# Configures pi rag dense fusion weight.
PI_RAG_DENSE_FUSION_WEIGHT=1.0
# Configures pi rag exact term boost.
PI_RAG_EXACT_TERM_BOOST=0.15
# Configures pi rag source volume discount strength.
PI_RAG_SOURCE_VOLUME_DISCOUNT_STRENGTH=0.0
# Enables or disables pi rag neighbor expansion enabled.
PI_RAG_NEIGHBOR_EXPANSION_ENABLED=true
# Configures pi rag max neighbors per anchor.
PI_RAG_MAX_NEIGHBORS_PER_ANCHOR=1
# Local embedding removes the monthly Pinecone integrated-embedding token quota
# from the request path. Requires scripts/download_local_embedder.py once.
PI_RAG_EMBEDDING_PROVIDER=local
# Configures pi rag embedding dimensions.
PI_RAG_EMBEDDING_DIMENSIONS=1024
# Configures pi rag local embedding model.
PI_RAG_LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Configures pi rag local embedding revision.
PI_RAG_LOCAL_EMBEDDING_REVISION=
# Configures pi rag local embedding device.
PI_RAG_LOCAL_EMBEDDING_DEVICE=mps
# Configures pi rag local embedding path.
PI_RAG_LOCAL_EMBEDDING_PATH=.models/multilingual-e5-large
# Configures pi rag local embedding batch size.
PI_RAG_LOCAL_EMBEDDING_BATCH_SIZE=16
# Configures pi rag warm local embedder on startup.
PI_RAG_WARM_LOCAL_EMBEDDER_ON_STARTUP=true
# Configures pi rag lexical corpus warm timeout seconds.
PI_RAG_LEXICAL_CORPUS_WARM_TIMEOUT_SECONDS=20
# Configures pi rag lexical corpus warm retry seconds.
PI_RAG_LEXICAL_CORPUS_WARM_RETRY_SECONDS=10
# Configures pi rag rerank provider.
PI_RAG_RERANK_PROVIDER=local
# Configures pi rag rerank model.
PI_RAG_RERANK_MODEL=bge-reranker-v2-m3
# Configures pi rag local rerank model.
PI_RAG_LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Configures pi rag grounding score threshold.
PI_RAG_GROUNDING_SCORE_THRESHOLD=0.65
# Configures pi rag grounding cross language score threshold.
PI_RAG_GROUNDING_CROSS_LANGUAGE_SCORE_THRESHOLD=0.60
# Rewrite Markdown tables as one sentence per row before the cross-encoder sees
# them, on the scoring path only. The generator still receives the original
# table. Leave on unless a corpus has tables the linearizer mis-reads.
PI_RAG_LINEARIZE_TABLE_EVIDENCE=true
# Optional, and off by default: a lower grounding bar for claims whose evidence
# is a table. Linearization is meant to make the normal bar reachable; set this
# only after evaluation/inspect_grounding_evidence.py shows the linearized score
# still falling short on evidence that does support the claim.
PI_RAG_GROUNDING_TABLE_EVIDENCE_SCORE_THRESHOLD=0.60
# Configures pi rag exact code rerank score threshold.
PI_RAG_EXACT_CODE_RERANK_SCORE_THRESHOLD=0.65
# Configures pi rag exact code retrieval score floor.
PI_RAG_EXACT_CODE_RETRIEVAL_SCORE_FLOOR=0.80
# Configures pi rag local rerank revision.
PI_RAG_LOCAL_RERANK_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
# Configures pi rag local rerank device.
PI_RAG_LOCAL_RERANK_DEVICE=mps
# A 50-candidate pool at batch 8 is seven sequential MPS round trips.
PI_RAG_LOCAL_RERANK_BATCH_SIZE=32
# Configures pi rag local rerank max length.
PI_RAG_LOCAL_RERANK_MAX_LENGTH=1024
# Configures pi rag local models path.
PI_RAG_LOCAL_MODELS_PATH=
# Configures pi rag rerank top n.
PI_RAG_RERANK_TOP_N=8
# Configures pi rag feature inventory top n.
PI_RAG_FEATURE_INVENTORY_TOP_N=25
# Configures pi rag rerank score threshold.
PI_RAG_RERANK_SCORE_THRESHOLD=0.10
# Configures pi rag entity overview rerank score threshold.
PI_RAG_ENTITY_OVERVIEW_RERANK_SCORE_THRESHOLD=0.05
# Configures pi rag max candidates.
PI_RAG_MAX_CANDIDATES=50
# Configures pi rag max chunks per source.
PI_RAG_MAX_CHUNKS_PER_SOURCE=3
# Secret value for pi rag max evidence tokens; inject it per environment and never commit a real value.
PI_RAG_MAX_EVIDENCE_TOKENS=16000
# Enables or disables pi rag adaptive temperature enabled.
PI_RAG_ADAPTIVE_TEMPERATURE_ENABLED=true
# Configures pi rag factual temperature.
PI_RAG_FACTUAL_TEMPERATURE=0.0
# Configures pi rag synthesis temperature.
PI_RAG_SYNTHESIS_TEMPERATURE=0.1
# Enables or disables pi rag translation enabled.
PI_RAG_TRANSLATION_ENABLED=true
# Enables or disables pi rag grounding verification enabled.
PI_RAG_GROUNDING_VERIFICATION_ENABLED=true

# Provider orchestration. Per-request enabledProviders may further narrow this
# project-safe allowlist, but can never enable a provider absent here.
PI_RAG_PROVIDER_ROUTER_ENABLED=true
# Network location for pi rag atlassian service url.
PI_RAG_ATLASSIAN_SERVICE_URL=http://atlassian:8000
# Secret value for pi rag atlassian service internal api key; inject it per environment and never commit a real value.
PI_RAG_ATLASSIAN_SERVICE_INTERNAL_API_KEY=
# Enables or disables pi rag atlassian live verification enabled.
PI_RAG_ATLASSIAN_LIVE_VERIFICATION_ENABLED=false
# Enables or disables pi rag provider federation enabled.
PI_RAG_PROVIDER_FEDERATION_ENABLED=true
# Enables or disables pi rag structured jira enabled.
PI_RAG_STRUCTURED_JIRA_ENABLED=true
# Configures pi rag enabled providers.
PI_RAG_ENABLED_PROVIDERS=["JIRA","GITHUB","CONFLUENCE"]
# Configures pi rag provider timeout seconds.
PI_RAG_PROVIDER_TIMEOUT_SECONDS=20
# Enables or disables pi rag structured conversation enabled.
PI_RAG_STRUCTURED_CONVERSATION_ENABLED=true
# Configures pi rag provider max list items.
PI_RAG_PROVIDER_MAX_LIST_ITEMS=50

# LiteLLM SDK uses the provider and model names already configured above. The
# selected PI_RAG_LLM_PROVIDER is primary; other fully configured providers are
# failure fallbacks only.
PI_RAG_MODEL_GATEWAY=litellm
# Enables or disables pi rag litellm fallbacks enabled.
PI_RAG_LITELLM_FALLBACKS_ENABLED=true
# Configures pi rag litellm routing strategy.
PI_RAG_LITELLM_ROUTING_STRATEGY=latency-based-routing

# Primary collection route used by serving and by flag-free live evaluation gates.
PI_RAG_CHROMA_COLLECTION=project-intelligence
# Explicit operator-approved secondary routes, e.g. isolated evaluation targets.
PI_RAG_ADDITIONAL_CHROMA_COLLECTIONS=[]
